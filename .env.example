# Copy this file to ".env" and fill in whatever you have. Everything is optional.

# AI stylist: with no key the built-in rule-based stylist answers.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=

# Real editorial fashion photography for the hero (free key: https://www.pexels.com/api/)
PEXELS_API_KEY=

PORT=8787
# JWT_SECRET=change-me   (auto-generated and stored if left empty)

# ── Email (verification codes, password reset) ──
# Option A, easiest: https://resend.com (free tier). Use a verified sender in MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=Atelier <hello@yourdomain.com>
# Option B: any SMTP server. Gmail: smtp.gmail.com, port 465, your address, and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# With neither option set, emails are printed in the server console and saved to server/storage/outbox.log,
# and the app shows the code on screen (development only; hidden when NODE_ENV=production).
